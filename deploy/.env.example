# Copy to deploy/.env (gitignored). Read by compose.yaml and passed to the app containers.

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# homebox's ZeroTier IP (`sudo zerotier-cli listnetworks`)
ALLOWED_HOSTS=10.x.y.z
BIND_IP=10.x.y.z

POSTGRES_PASSWORD=change-me

GRIME_WORKER_SLOTS=3

# Optional, for --textract OCR
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
